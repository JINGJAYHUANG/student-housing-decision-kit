{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/student-housing-decision-kit/listing.schema.json",
  "title": "Student housing listing row",
  "description": "JSON representation of one CSV listing row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listing_id",
    "name",
    "area",
    "housing_mode",
    "bedrooms",
    "bathrooms",
    "monthly_rent_total",
    "monthly_required_fees_total",
    "monthly_utilities_estimate",
    "occupants",
    "commute_minutes",
    "safety_score",
    "convenience_score",
    "management_score",
    "quiet_score",
    "space_score",
    "application_score",
    "available_date",
    "source_checked_at",
    "source_url",
    "is_synthetic",
    "first_month_required",
    "last_month_required",
    "security_deposit_months",
    "broker_fee_months",
    "one_time_fees"
  ],
  "properties": {
    "listing_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "area": { "type": "string", "minLength": 1 },
    "housing_mode": { "enum": ["solo", "shared"] },
    "bedrooms": { "type": "number", "minimum": 0 },
    "bathrooms": { "type": "number", "exclusiveMinimum": 0 },
    "sqft": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "monthly_rent_total": { "type": "number", "exclusiveMinimum": 0 },
    "monthly_required_fees_total": { "type": "number", "minimum": 0 },
    "monthly_utilities_estimate": { "type": "number", "minimum": 0 },
    "occupants": { "type": "integer", "minimum": 1 },
    "commute_minutes": { "type": "number", "minimum": 0 },
    "safety_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "convenience_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "management_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "quiet_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "space_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "application_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "available_date": { "type": "string", "format": "date" },
    "source_checked_at": { "type": "string", "format": "date" },
    "source_url": { "type": "string", "minLength": 1 },
    "is_synthetic": { "type": "boolean" },
    "first_month_required": { "type": "boolean" },
    "last_month_required": { "type": "boolean" },
    "security_deposit_months": { "type": "number", "minimum": 0 },
    "broker_fee_months": { "type": "number", "minimum": 0 },
    "one_time_fees": { "type": "number", "minimum": 0 },
    "notes": { "type": "string" }
  }
}
